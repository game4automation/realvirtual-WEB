{
  "name": "realvirtual-web",
  "version": "6.3.16",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-private-dependencies.mjs && node scripts/patch-occt-memory.mjs",
    "patch:occt": "node scripts/patch-occt-memory.mjs",
    "predev": "node scripts/install-private-dependencies.mjs",
    "dev": "vite",
    "prebuild": "node scripts/install-private-dependencies.mjs --internal-only && node scripts/patch-occt-memory.mjs && node scripts/build-local-library-catalog.mjs",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "postbuild": "node scripts/inject-ga-settings.mjs",
    "preview": "vite preview",
    "preview:embed": "vite preview --outDir dist-embed --port 4178 --strictPort",
    "pretest": "node scripts/test-lock.mjs acquire",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.full.json --noEmit",
    "gen:private-excludes": "node scripts/gen-private-test-excludes.mjs",
    "posttest": "node scripts/test-lock.mjs release",
    "test:watch": "vitest",
    "pree2e": "node scripts/test-lock.mjs acquire",
    "e2e": "npx playwright test",
    "poste2e": "node scripts/test-lock.mjs release",
    "e2e:headed": "npx playwright test --headed",
    "preperf": "node scripts/test-lock.mjs acquire",
    "perf": "npx playwright test e2e/perf-smoke.spec.ts --headed",
    "postperf": "node scripts/test-lock.mjs release",
    "build:aasx-index": "node scripts/build-aasx-index.mjs",
    "build:library": "node scripts/build-local-library-catalog.mjs",
    "deploy": "node scripts/bunny-deploy.mjs",
    "deploy:private": "node scripts/bunny-deploy.mjs --private",
    "deploy:embed": "npm run build:embed && node scripts/embed-deploy.mjs",
    "deploy:embed:dry-run": "npm run build:embed && node scripts/embed-deploy.mjs --dry-run",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:all": "node scripts/run-all-tests.mjs",
    "lint": "eslint src/"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@microsoft/teams-js": "^2.51.0",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@noble/ed25519": "3.1.0",
    "@tanstack/react-virtual": "^3.13.22",
    "chevrotain": "^12.0.0",
    "echarts": "^6.0.0",
    "fuse.js": "^7.4.2",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.55.1",
    "mqtt": "^5.15.1",
    "n8ao": "^1.10.1",
    "occt-import-js": "0.0.23",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-pdf": "^10.4.1",
    "read-excel-file": "^5.8.5",
    "stats-gl": "^4.1.0",
    "three": "0.185.1",
    "three-mesh-bvh": "^0.9.9"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "@types/webxr": "^0.5.24",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@webgpu/types": "^0.1.71",
    "eslint": "^10.4.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "playwright": "^1.58.2",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.59.0",
    "@rollup/rollup-darwin-x64": "^4.59.0",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0"
  }
}
