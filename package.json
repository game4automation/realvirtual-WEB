{
  "name": "realvirtual-web",
  "version": "6.7.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/install-private-dependencies.mjs && node scripts/patch-occt-memory.mjs",
    "patch:occt": "node scripts/patch-occt-memory.mjs",
    "arch": "node scripts/arch-graph.mjs",
    "predev": "node scripts/install-private-dependencies.mjs",
    "dev": "vite",
    "prebuild": "node scripts/install-private-dependencies.mjs --internal-only && node scripts/patch-occt-memory.mjs && node scripts/build-local-library-catalog.mjs",
    "build": "vite build",
    "features:generate": "node scripts/gen-features-json.mjs",
    "build:embed": "vite build --config vite.embed.config.ts",
    "test:bundle-guard": "node scripts/test-bundle-guard.mjs --mode enforce",
    "postbuild": "node scripts/inject-ga-settings.mjs",
    "viewer:chrome": "node scripts/launch-viewer-chrome.mjs",
    "viewer:agent": "node scripts/launch-viewer-chrome.mjs --agent",
    "recording:mcp": "node scripts/recording/server.mjs",
    "recording:run": "node scripts/recording/run.mjs",
    "recording:test": "node --test scripts/recording/recording.test.mjs",
    "tutorial:run": "node scripts/tutorial/run.mjs",
    "tutorial:test": "node scripts/with-test-lock.mjs scripts/tutorial/tutorial.e2e.test.mjs",
    "tutorial:test:viewer": "node scripts/with-test-lock.mjs scripts/tutorial/tutorial.viewer.test.mjs",
    "record": "node scripts/rv-record-video.mjs",
    "preview": "vite preview",
    "preview:embed": "vite preview --outDir dist-embed --port 4178 --strictPort",
    "test": "node scripts/with-test-lock.mjs vitest run",
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc -p tsconfig.full.json --noEmit",
    "gen:mcp-docs": "node scripts/gen-mcp-docs.mjs",
    "gen:odt-split": "node scripts/gen-odt-split.mjs",
    "docs:generate": "node scripts/community-docs.mjs --write",
    "docs:check": "node scripts/community-docs.mjs && node scripts/assert-docs-publishable.mjs --working-tree",
    "docs:test": "node --test scripts/community-docs.test.mjs",
    "build:project-scripts": "node scripts/compile-project-scripts.mjs",
    "gen:private-excludes": "node scripts/gen-private-test-excludes.mjs",
    "gate:dev-assets": "node scripts/gate-dev-assets.mjs",
    "gate:dev-assets-absent": "node scripts/gate-dev-assets.mjs --absent",
    "gen:dev-asset-tests": "node scripts/gate-dev-assets.mjs --regenerate",
    "test:watch": "node scripts/with-test-lock.mjs vitest",
    "e2e": "node scripts/with-test-lock.mjs playwright test",
    "e2e:headed": "node scripts/with-test-lock.mjs playwright test --headed",
    "e2e:terms-boot": "node scripts/with-test-lock.mjs playwright test --config playwright.terms-boot.config.ts",
    "smoke:prod": "node scripts/rv-demo-smoke.mjs",
    "perf": "node scripts/with-test-lock.mjs playwright test e2e/perf-smoke.spec.ts --headed",
    "perf:des": "node scripts/with-test-lock.mjs scripts/perf-des.mjs",
    "perf:matrix": "node scripts/with-test-lock.mjs scripts/perf-scale-matrix.mjs",
    "perf:soak": "node scripts/with-test-lock.mjs scripts/perf-soak.mjs",
    "perf:load": "node scripts/with-test-lock.mjs scripts/perf-signal-load.mjs",
    "build:aasx-index": "node scripts/build-aasx-index.mjs",
    "audit:instruction-targets": "node scripts/rv-audit-instruction-targets.mjs",
    "build:library": "node scripts/build-local-library-catalog.mjs",
    "deploy": "node scripts/bunny-deploy.mjs",
    "deploy:private": "node scripts/bunny-deploy.mjs --private",
    "publish:project": "node scripts/publish-project.mjs",
    "share:encrypt": "node scripts/share-encrypt.mjs",
    "deploy:embed": "npm run build:embed && node scripts/embed-deploy.mjs",
    "deploy:embed:dry-run": "npm run build:embed && node scripts/embed-deploy.mjs --dry-run",
    "test:node": "node scripts/with-test-lock.mjs vitest run --config vitest.node.config.ts",
    "test:gpu": "node scripts/with-test-lock.mjs vitest run --config vitest.gpu.config.ts",
    "test:models": "node scripts/with-test-lock.mjs vitest run tests/models",
    "test:all": "node scripts/with-test-lock.mjs scripts/run-all-tests.mjs",
    "lint": "eslint src/",
    "lint:baseline": "eslint --suppress-rule no-restricted-syntax \"src/core/hmi/rv-*inspector*.tsx\" \"src/core/hmi/rv-field-*.tsx\" \"src/core/hmi/rv-component-section.tsx\" \"src/core/hmi/rv-signal-slot-row.tsx\" \"src/core/hmi/rv-*-field-renderer.tsx\" \"src/core/hmi/Fmu*.tsx\" \"src/core/hmi/inspector-*.tsx\" \"src/core/hmi/rv-baked-geometry-section.tsx\" \"src/plugins/signal-bind/*.tsx\"",
    "lint:prune": "eslint --prune-suppressions \"src/core/hmi/rv-*inspector*.tsx\" \"src/core/hmi/rv-field-*.tsx\" \"src/core/hmi/rv-component-section.tsx\" \"src/core/hmi/rv-signal-slot-row.tsx\" \"src/core/hmi/rv-*-field-renderer.tsx\" \"src/core/hmi/Fmu*.tsx\" \"src/core/hmi/inspector-*.tsx\" \"src/core/hmi/rv-baked-geometry-section.tsx\" \"src/plugins/signal-bind/*.tsx\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.8",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@microsoft/teams-js": "^2.51.0",
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@noble/ed25519": "3.1.0",
    "@tanstack/react-virtual": "^3.13.22",
    "@zip.js/zip.js": "2.18.2",
    "acorn": "8.16.0",
    "chevrotain": "^12.0.0",
    "echarts": "^6.0.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "fuse.js": "^7.4.2",
    "jsonc-parser": "~3.3.1",
    "jszip": "^3.10.1",
    "mediabunny": "1.61.0",
    "meshoptimizer": "^1.1.1",
    "monaco-editor": "^0.55.1",
    "mqtt": "^5.15.1",
    "n8ao": "^1.10.1",
    "occt-import-js": "0.0.23",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "read-excel-file": "^5.8.5",
    "remark-gfm": "^4.0.1",
    "stats-gl": "^4.1.0",
    "three": "0.185.1",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "@types/webxr": "^0.5.24",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@webgpu/types": "^0.1.71",
    "draco3dgltf": "^1.5.7",
    "eslint": "^10.4.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.59.0",
    "@rollup/rollup-darwin-x64": "^4.59.0",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0"
  }
}
