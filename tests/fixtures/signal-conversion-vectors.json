{
  "$comment": "plan-2227 canonical SignalConnector conversion vectors. SSOT for WEB (rv-signal-conversion.ts), Unity (SignalConversion.cs) and CONNECT (verbatim copies). Inputs/expectations: INT values are signed int32 storage; REAL expectations compare float32-exact (1 ULP). 'NaN', 'Infinity', '-Infinity' are spelled as strings. expect null = the connector writes nothing. Options not listed take the schema defaults (Condition NotZero, CompareValue 0, TrueValue 1, FalseValue 0, Bit 0, Width Word, Signed true, Factor 1, Offset 0, Rounding Round, Invert false).",
  "version": 1,
  "convert": [
    { "name": "copy bool true", "mode": "Copy", "source": "bool", "target": "bool", "input": true, "expect": true },
    { "name": "copy bool false", "mode": "Copy", "source": "bool", "target": "bool", "input": false, "expect": false },
    { "name": "copy bool inverted", "mode": "Copy", "source": "bool", "target": "bool", "input": true, "options": { "Invert": true }, "expect": false },
    { "name": "copy int", "mode": "Copy", "source": "int", "target": "int", "input": 42, "expect": 42 },
    { "name": "copy int 0x80000000 stays negative", "mode": "Copy", "source": "int", "target": "int", "input": -2147483648, "expect": -2147483648 },
    { "name": "copy int 0x80000000 spelled unsigned wraps to signed storage", "mode": "Copy", "source": "int", "target": "int", "input": 2147483648, "expect": -2147483648 },
    { "name": "copy int 0xFFFFFFFF spelled unsigned is -1", "mode": "Copy", "source": "int", "target": "int", "input": 4294967295, "expect": -1 },
    { "name": "copy int to real at float precision limit", "mode": "Copy", "source": "int", "target": "real", "input": 16777217, "expect": 16777216 },
    { "name": "copy real", "mode": "Copy", "source": "real", "target": "real", "input": 1.5, "expect": 1.5 },
    { "name": "copy real rounds to float32", "mode": "Copy", "source": "real", "target": "real", "input": 0.1, "expect": 0.10000000149011612 },
    { "name": "copy real 1e39 overflows float32", "mode": "Copy", "source": "real", "target": "real", "input": 1e39, "expect": null },
    { "name": "copy real -1e39 overflows float32", "mode": "Copy", "source": "real", "target": "real", "input": -1e39, "expect": null },
    { "name": "copy real NaN", "mode": "Copy", "source": "real", "target": "real", "input": "NaN", "expect": null },
    { "name": "copy real Infinity", "mode": "Copy", "source": "real", "target": "real", "input": "Infinity", "expect": null },
    { "name": "copy bool to int is not a copy pair", "mode": "Copy", "source": "bool", "target": "int", "input": true, "expect": null },

    { "name": "int to bool NotZero 0", "mode": "IntToBool", "source": "int", "target": "bool", "input": 0, "expect": false },
    { "name": "int to bool NotZero 5", "mode": "IntToBool", "source": "int", "target": "bool", "input": 5, "expect": true },
    { "name": "int to bool NotZero negative is true", "mode": "IntToBool", "source": "int", "target": "bool", "input": -1, "expect": true },
    { "name": "int to bool NotZero 0x80000000", "mode": "IntToBool", "source": "int", "target": "bool", "input": -2147483648, "expect": true },
    { "name": "int to bool NotZero inverted", "mode": "IntToBool", "source": "int", "target": "bool", "input": 0, "options": { "Invert": true }, "expect": true },
    { "name": "int to bool Equals hit", "mode": "IntToBool", "source": "int", "target": "bool", "input": 3, "options": { "Condition": "Equals", "CompareValue": 3 }, "expect": true },
    { "name": "int to bool Equals miss", "mode": "IntToBool", "source": "int", "target": "bool", "input": 4, "options": { "Condition": "Equals", "CompareValue": 3 }, "expect": false },
    { "name": "int to bool GreaterOrEqual equal", "mode": "IntToBool", "source": "int", "target": "bool", "input": 10, "options": { "Condition": "GreaterOrEqual", "CompareValue": 10 }, "expect": true },
    { "name": "int to bool GreaterOrEqual below", "mode": "IntToBool", "source": "int", "target": "bool", "input": 9, "options": { "Condition": "GreaterOrEqual", "CompareValue": 10 }, "expect": false },
    { "name": "int to bool GreaterOrEqual negative below 0", "mode": "IntToBool", "source": "int", "target": "bool", "input": -5, "options": { "Condition": "GreaterOrEqual", "CompareValue": 0 }, "expect": false },
    { "name": "int to bool GreaterOrEqual 0x80000000 is the smallest int", "mode": "IntToBool", "source": "int", "target": "bool", "input": -2147483648, "options": { "Condition": "GreaterOrEqual", "CompareValue": 0 }, "expect": false },

    { "name": "bool to int true default", "mode": "BoolToInt", "source": "bool", "target": "int", "input": true, "expect": 1 },
    { "name": "bool to int false default", "mode": "BoolToInt", "source": "bool", "target": "int", "input": false, "expect": 0 },
    { "name": "bool to int custom true", "mode": "BoolToInt", "source": "bool", "target": "int", "input": true, "options": { "TrueValue": 100, "FalseValue": -1 }, "expect": 100 },
    { "name": "bool to int custom false negative", "mode": "BoolToInt", "source": "bool", "target": "int", "input": false, "options": { "TrueValue": 100, "FalseValue": -1 }, "expect": -1 },

    { "name": "bit from word bit 0", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 1, "expect": true },
    { "name": "bit from word bit 3 set", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 8, "options": { "Bit": 3 }, "expect": true },
    { "name": "bit from word bit 3 clear", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 7, "options": { "Bit": 3 }, "expect": false },
    { "name": "bit from word bit 15 of signed -32768", "mode": "BitFromWord", "source": "int", "target": "bool", "input": -32768, "options": { "Bit": 15 }, "expect": true },
    { "name": "bit from word bit 15 of unsigned 32768", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 32768, "options": { "Bit": 15 }, "expect": true },
    { "name": "bit from dword bit 31 of 0x80000000", "mode": "BitFromWord", "source": "int", "target": "bool", "input": -2147483648, "options": { "Bit": 31, "Width": "DWord" }, "expect": true },
    { "name": "bit from dword bit 31 of int max", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 2147483647, "options": { "Bit": 31, "Width": "DWord" }, "expect": false },
    { "name": "bit from dword bit 31 of 0xFFFFFFFF", "mode": "BitFromWord", "source": "int", "target": "bool", "input": -1, "options": { "Bit": 31, "Width": "DWord" }, "expect": true },
    { "name": "bit from byte bit 7 of 255", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 255, "options": { "Bit": 7, "Width": "Byte" }, "expect": true },
    { "name": "bit from byte bit 7 of signed -1", "mode": "BitFromWord", "source": "int", "target": "bool", "input": -1, "options": { "Bit": 7, "Width": "Byte", "Signed": true }, "expect": true },
    { "name": "bit from byte bit 8 outside width", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 256, "options": { "Bit": 8, "Width": "Byte" }, "expect": null },
    { "name": "bit from word bit 0 inverted", "mode": "BitFromWord", "source": "int", "target": "bool", "input": 0, "options": { "Invert": true }, "expect": true },

    { "name": "bit to word contributes true", "mode": "BitToWord", "source": "bool", "target": "int", "input": true, "options": { "Bit": 4 }, "expect": true },
    { "name": "bit to word inverted", "mode": "BitToWord", "source": "bool", "target": "int", "input": true, "options": { "Bit": 4, "Invert": true }, "expect": false },
    { "name": "bit to word bit 16 outside word", "mode": "BitToWord", "source": "bool", "target": "int", "input": true, "options": { "Bit": 16 }, "expect": null },

    { "name": "scale int to int factor 2", "mode": "Scale", "source": "int", "target": "int", "input": 5, "options": { "Factor": 2 }, "expect": 10 },
    { "name": "scale int to real factor 0.1", "mode": "Scale", "source": "int", "target": "real", "input": 123, "options": { "Factor": 0.1 }, "expect": 12.300000190734863 },
    { "name": "scale real to int round +2.5", "mode": "Scale", "source": "real", "target": "int", "input": 2.5, "expect": 3 },
    { "name": "scale real to int round -2.5", "mode": "Scale", "source": "real", "target": "int", "input": -2.5, "expect": -3 },
    { "name": "scale real to int round 2.4", "mode": "Scale", "source": "real", "target": "int", "input": 2.4, "expect": 2 },
    { "name": "scale real to int round -0.4 is 0", "mode": "Scale", "source": "real", "target": "int", "input": -0.4, "expect": 0 },
    { "name": "scale real to int truncate 2.9", "mode": "Scale", "source": "real", "target": "int", "input": 2.9, "options": { "Rounding": "Truncate" }, "expect": 2 },
    { "name": "scale real to int truncate -2.9", "mode": "Scale", "source": "real", "target": "int", "input": -2.9, "options": { "Rounding": "Truncate" }, "expect": -2 },
    { "name": "scale offset +5.5 rounds away from zero", "mode": "Scale", "source": "int", "target": "int", "input": 0, "options": { "Factor": 0, "Offset": 5.5 }, "expect": 6 },
    { "name": "scale offset -5.5 rounds away from zero", "mode": "Scale", "source": "int", "target": "int", "input": 0, "options": { "Factor": 0, "Offset": -5.5 }, "expect": -6 },
    { "name": "scale real to dword 2147483647.5 round clamps", "mode": "Scale", "source": "real", "target": "int", "input": 2147483647.5, "options": { "Width": "DWord" }, "expect": 2147483647 },
    { "name": "scale real to dword 2147483647.5 truncate", "mode": "Scale", "source": "real", "target": "int", "input": 2147483647.5, "options": { "Width": "DWord", "Rounding": "Truncate" }, "expect": 2147483647 },
    { "name": "scale real to dword -2147483648.5 round clamps", "mode": "Scale", "source": "real", "target": "int", "input": -2147483648.5, "options": { "Width": "DWord" }, "expect": -2147483648 },
    { "name": "scale real 1e39 to dword clamps", "mode": "Scale", "source": "real", "target": "int", "input": 1e39, "options": { "Width": "DWord" }, "expect": 2147483647 },
    { "name": "scale real -1e39 to dword clamps", "mode": "Scale", "source": "real", "target": "int", "input": -1e39, "options": { "Width": "DWord" }, "expect": -2147483648 },
    { "name": "scale real 1e39 to real overflows", "mode": "Scale", "source": "real", "target": "real", "input": 1e39, "expect": null },
    { "name": "scale real -1e39 to real overflows", "mode": "Scale", "source": "real", "target": "real", "input": -1e39, "expect": null },
    { "name": "scale int 10 times 1e38 to real overflows float32", "mode": "Scale", "source": "int", "target": "real", "input": 10, "options": { "Factor": 1e38 }, "expect": null },
    { "name": "scale real 16777217 to real at float precision limit", "mode": "Scale", "source": "real", "target": "real", "input": 16777217, "expect": 16777216 },
    { "name": "scale real NaN to int", "mode": "Scale", "source": "real", "target": "int", "input": "NaN", "expect": null },
    { "name": "scale real Infinity to int", "mode": "Scale", "source": "real", "target": "int", "input": "Infinity", "expect": null },
    { "name": "scale real -Infinity to real", "mode": "Scale", "source": "real", "target": "real", "input": "-Infinity", "expect": null },
    { "name": "scale real to byte unsigned clamps 300", "mode": "Scale", "source": "real", "target": "int", "input": 300, "options": { "Width": "Byte", "Signed": false }, "expect": 255 },
    { "name": "scale real to byte signed clamps 200", "mode": "Scale", "source": "real", "target": "int", "input": 200, "options": { "Width": "Byte", "Signed": true }, "expect": 127 },
    { "name": "scale real to byte signed clamps -200", "mode": "Scale", "source": "real", "target": "int", "input": -200, "options": { "Width": "Byte", "Signed": true }, "expect": -128 },
    { "name": "scale real to word unsigned clamps -5", "mode": "Scale", "source": "real", "target": "int", "input": -5, "options": { "Width": "Word", "Signed": false }, "expect": 0 },
    { "name": "scale real to word signed clamps 40000", "mode": "Scale", "source": "real", "target": "int", "input": 40000, "options": { "Width": "Word", "Signed": true }, "expect": 32767 },
    { "name": "scale real to dword unsigned 0xFFFFFFFF stores -1", "mode": "Scale", "source": "real", "target": "int", "input": 4294967295, "options": { "Width": "DWord", "Signed": false }, "expect": -1 },
    { "name": "scale real to dword unsigned 5e9 clamps to 0xFFFFFFFF", "mode": "Scale", "source": "real", "target": "int", "input": 5000000000, "options": { "Width": "DWord", "Signed": false }, "expect": -1 },
    { "name": "scale int byte signed reads 255 as -1", "mode": "Scale", "source": "int", "target": "int", "input": 255, "options": { "Width": "Byte", "Signed": true }, "expect": -1 },
    { "name": "scale int byte unsigned reads 255", "mode": "Scale", "source": "int", "target": "int", "input": 255, "options": { "Width": "Byte", "Signed": false }, "expect": 255 },
    { "name": "scale int byte signed reads 0xFF of -1 as -1", "mode": "Scale", "source": "int", "target": "real", "input": -1, "options": { "Width": "Byte", "Signed": true }, "expect": -1 },
    { "name": "scale int byte unsigned reads -1 as 255", "mode": "Scale", "source": "int", "target": "real", "input": -1, "options": { "Width": "Byte", "Signed": false }, "expect": 255 },
    { "name": "scale int dword unsigned reads 0xFFFFFFFF", "mode": "Scale", "source": "int", "target": "real", "input": -1, "options": { "Width": "DWord", "Signed": false }, "expect": 4294967296 },
    { "name": "scale int dword signed 0x80000000 to real", "mode": "Scale", "source": "int", "target": "real", "input": -2147483648, "options": { "Width": "DWord" }, "expect": -2147483648 },
    { "name": "scale bool source is not a scale pair", "mode": "Scale", "source": "bool", "target": "int", "input": true, "expect": null }
  ],
  "word": [
    { "name": "no bits is 0", "width": "Word", "signed": true, "bits": [], "expect": 0 },
    { "name": "bits 0 and 2", "width": "Word", "signed": true, "bits": [{ "bit": 0, "on": true }, { "bit": 2, "on": true }, { "bit": 1, "on": false }], "expect": 5 },
    { "name": "word signed bit 15", "width": "Word", "signed": true, "bits": [{ "bit": 15, "on": true }], "expect": -32768 },
    { "name": "word unsigned bit 15", "width": "Word", "signed": false, "bits": [{ "bit": 15, "on": true }], "expect": 32768 },
    { "name": "byte signed bit 7", "width": "Byte", "signed": true, "bits": [{ "bit": 7, "on": true }], "expect": -128 },
    { "name": "byte unsigned bit 7", "width": "Byte", "signed": false, "bits": [{ "bit": 7, "on": true }], "expect": 128 },
    { "name": "byte ignores bit 8", "width": "Byte", "signed": false, "bits": [{ "bit": 8, "on": true }], "expect": 0 },
    { "name": "dword signed bit 31 is 0x80000000", "width": "DWord", "signed": true, "bits": [{ "bit": 31, "on": true }], "expect": -2147483648 },
    { "name": "dword unsigned bit 31 stores signed", "width": "DWord", "signed": false, "bits": [{ "bit": 31, "on": true }], "expect": -2147483648 },
    { "name": "dword all bits is 0xFFFFFFFF", "width": "DWord", "signed": false, "bits": [
      { "bit": 0, "on": true }, { "bit": 1, "on": true }, { "bit": 2, "on": true }, { "bit": 3, "on": true },
      { "bit": 4, "on": true }, { "bit": 5, "on": true }, { "bit": 6, "on": true }, { "bit": 7, "on": true },
      { "bit": 8, "on": true }, { "bit": 9, "on": true }, { "bit": 10, "on": true }, { "bit": 11, "on": true },
      { "bit": 12, "on": true }, { "bit": 13, "on": true }, { "bit": 14, "on": true }, { "bit": 15, "on": true },
      { "bit": 16, "on": true }, { "bit": 17, "on": true }, { "bit": 18, "on": true }, { "bit": 19, "on": true },
      { "bit": 20, "on": true }, { "bit": 21, "on": true }, { "bit": 22, "on": true }, { "bit": 23, "on": true },
      { "bit": 24, "on": true }, { "bit": 25, "on": true }, { "bit": 26, "on": true }, { "bit": 27, "on": true },
      { "bit": 28, "on": true }, { "bit": 29, "on": true }, { "bit": 30, "on": true }, { "bit": 31, "on": true }
    ], "expect": -1 }
  ],
  "connectSignal": [
    { "name": "legacy int 5 to bool", "source": "int", "target": "bool", "input": 5, "expect": true },
    { "name": "legacy int 0 to bool", "source": "int", "target": "bool", "input": 0, "expect": false },
    { "name": "legacy negative int to bool is false", "source": "int", "target": "bool", "input": -3, "expect": false },
    { "name": "legacy 0x80000000 to bool is false", "source": "int", "target": "bool", "input": -2147483648, "expect": false },
    { "name": "legacy bool true to int", "source": "bool", "target": "int", "input": true, "expect": 1 },
    { "name": "legacy bool false to int", "source": "bool", "target": "int", "input": false, "expect": 0 },
    { "name": "legacy int to int raw", "source": "int", "target": "int", "input": 7, "expect": 7 },
    { "name": "legacy real to real raw", "source": "real", "target": "real", "input": 1.5, "expect": 1.5 },
    { "name": "legacy bool to bool raw", "source": "bool", "target": "bool", "input": true, "expect": true },
    { "name": "legacy int to real raw", "source": "int", "target": "real", "input": 3, "expect": 3 }
  ]
}
