node_modules/
dist/
dist-private/
dist-embed/
# Per-tier build outputs for the three-tier build proof (tests/mechanism-tier.node.test.ts)
dist-public/
dist-customer/
dist-internal/
.vite/

# CONNECT's workspace runtime folder (plan-363 Phase 4). In Dev mode CONNECT keeps
# its data AND its connect-config.json here — the latter carries the InfluxDB token,
# and the folder also collects the CAD conversion caches, which reach hundreds of MB.
# Neither may ever enter a changeset, least of all in a tree that is mirrored to a
# public remote.
.runtime/
.playwright-profile
test-results/
*.local
*.tsbuildinfo
.mcp.json
.vscode/

# Bunny deploy credentials — never commit. (.env.production is auto-loaded by
# Vite on prod builds, so it must stay ignored too.)
.env
.env.production

# Local test working folder (large GLB/splat assets, not for the repo)
LocalFolderTest/

# Oversized AASX asset (exceeds GitHub 100 MB limit)
public/aasx/26_SEW_KA47-DRN90M4.aasx

# plan-360's decision that test/dev models are tracked here via Git LFS is
# SUPERSEDED by plan-395 and the comment that stated it is gone, because it was
# the wrong thing to read next: its reasoning was that browser tests break hard
# when a fixture is missing and cannot skip. They can - measured, and the whole
# mechanism is in tests/fixtures/dev-asset-available.ts. Every internal model
# and fixture now lives in the private sibling's projects/Development/ and is
# served over /private-assets/. Nothing internal is tracked here at all any
# more, so there is no allowlist left to rely on for keeping it out of a deploy.

# Private customer models — canonical location is
# ../realvirtual-WebViewer-Private~/projects/<name>/models/ (served via
# /private-models/ in dev, staged by stagePrivateProject on private deploys).
# Listed here as a hard guard so a stray local copy can never be committed.
public/models/MauserCageline30.glb
public/models/Toray.glb

# Generated caches — rebuilt on demand, never source. The condensed cache alone
# reached 1.8 GB locally, which must never enter the repo (public remote is an
# unfiltered mirror).
public/models/.condensed-cache/
public/models/library/.thumbnails/

# CAD landing zones — ignored as FOLDERS, not filenames (2026-08-28). The old
# filename deny-list let 103 MB of customer/scratch geometry into the public
# mirror under names nobody had predicted (testfork.glb, ff.glb, …). These two
# folders are defined by their purpose — everything a CAD/import session drops
# lands here — so nothing in them is ever repo content. Customer-derived
# geometry belongs in ../realvirtual-WebViewer-Private~/projects/<name>/models/;
# the NDA models kept locally in these folders stay under Plastic control
# (<WS>\ignore.conf), never git.
# plan-395 emptied both of these: Custom/ moved into the private Development
# project, imports/ was deleted outright (an import landing zone is transient by
# definition). The rules STAY - they are what stops the next import session from
# refilling a folder that no longer has any business existing here.
public/models/library/Custom/
public/models/library/imports/
public/_tmp/
public/models/D5347024_1-matrices.glb

# impeccable design-tool state (critiques, live-injection config, hook cache).
# Local working state of the design skill — its critiques are internal review
# material and must never reach the public mirror. The Vite plugin
# rv-strip-impeccable-live + the bunny-lib check guard the BUILD; this line
# guards the REPO.
.impeccable/

# Stray tool logs at the repo root (e.g. vite.omniverse-debug.*.log).
/*.log

# Vitest browser failure screenshots - auto-generated on every red test run,
# never read back by anything (no toMatchScreenshot in the repo). Untracked
# on purpose; the previously committed ones were removed 2026-08-11.
tests/**/__screenshots__/

# plan-395 gate artefacts: the vitest JSON reports the two dev-asset gates are
# computed from, plus their logs. Regenerated per run, never source.
.rv-395-*.json
.rv-395-*.log
