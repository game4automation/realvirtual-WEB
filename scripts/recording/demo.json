{
  "recording": { "width": 1920, "height": 1080, "maxDurationSec": 180 },
  "batches": [
    [
      { "type": "waitFor", "selector": "a:has-text(\"Open demo scene\")", "timeoutMs": 60000 },
      { "type": "click", "selector": "a:has-text(\"Open demo scene\")" }
    ],
    [
      { "type": "waitFor", "selector": "#rv-viewport canvas", "timeoutMs": 60000 },
      { "type": "waitFor", "selector": "#loading-overlay.hidden", "state": "attached", "timeoutMs": 60000 },
      { "type": "wait", "ms": 2000 }
    ],
    [
      { "type": "press", "key": "Space" },
      { "type": "wait", "ms": 1000 },
      { "type": "press", "key": "Space" },
      { "type": "wait", "ms": 4000 },
      { "type": "drag", "button": "right", "fromX": 1000, "fromY": 550, "toX": 1250, "toY": 620, "durationMs": 2000 },
      { "type": "wait", "ms": 2000 },
      { "type": "click", "selector": "button[aria-label=\"Drives\"]" },
      { "type": "wait", "ms": 4000 }
    ]
  ]
}
