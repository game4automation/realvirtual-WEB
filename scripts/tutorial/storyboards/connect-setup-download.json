{
  "$schema": "rv-tutorial/1",
  "id": "connect-setup-download",
  "title": "realvirtual WEB - Set up CONNECT (part 1: open the demo and download CONNECT)",
  "url": "/?doc=doc_demorealvirtualweb_7l7hfw&mode=hmi",
  "connect": "off",
  "viewport": { "width": 1920, "height": 1080 },
  "welcome": "dismiss",
  "ready": "#rv-viewport",
  "minStepSec": 2,
  "setup": [
    { "type": "waitFor", "scene": true, "doc": "rvproject:DemoRealvirtualWeb.glb", "timeoutMs": 60000 }
  ],
  "steps": [
    {
      "id": "overview",
      "holdSec": 2,
      "actions": [
        { "type": "camera", "position": [3.9, 3.6, 3.4], "target": [0.62, 1.1, 0.4], "durationSec": 2 },
        { "type": "camera", "position": [7.13, 5.89, 6.64], "target": [0.62, 1.23, 0.13], "durationSec": 2 }
      ]
    },
    {
      "id": "open-connect-panel",
      "holdSec": 3,
      "actions": [
        { "type": "click", "target": { "selector": "button[aria-label=\"realvirtual CONNECT\"]" } },
        { "type": "waitFor", "selector": "a[href$=\"realvirtual-Connect.exe\"]", "timeoutMs": 10000 }
      ]
    },
    {
      "id": "point-at-download",
      "holdSec": 2,
      "actions": [
        { "type": "hover", "target": { "x": 220, "y": 120 } },
        { "type": "wait", "ms": 600 },
        { "type": "hover", "target": { "selector": "a[href$=\"realvirtual-Connect.exe\"]" } }
      ]
    },
    {
      "id": "click-download",
      "holdSec": 2,
      "tailSec": 0.4,
      "actions": [
        { "type": "click", "target": { "selector": "a[href$=\"realvirtual-Connect.exe\"]" } }
      ]
    }
  ]
}
